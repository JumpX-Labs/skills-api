# ──────────────────────────────────────────────────────────────
# JumpXAI · skills-api 环境变量（部署到 Dokploy 时填这些）
# 真实值勿提交；在 Dokploy 的 Environment 面板里配。
# ──────────────────────────────────────────────────────────────

# ── 服务 ──
PORT=3456
HOST=0.0.0.0
# 允许跨域来源。生产建议收紧为 JumpXAI 平台域名，逗号分隔；默认 * 放开
CORS_ORIGIN=*

# ── 数据存储：Cloudflare R2（S3 兼容）──
# 配了 S3_BUCKET 即启用 R2；首次启动若桶为空，会自动用内置 10MB 数据 seed 上去
S3_BUCKET=jumpxai-skills
S3_KEY=skills-data.json
# R2 用 auto；S3_ENDPOINT 指向你的 R2 账户端点
S3_REGION=auto
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 API Token 的 Access Key / Secret（标准 AWS 凭证变量）
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>

# ── 增量维护：自动刷新调度器 ──
# 开启后每隔 REFRESH_INTERVAL 分钟跑一次抓取并写回 R2
AUTO_REFRESH=true
REFRESH_INTERVAL=720
# scraper 抓 GitHub 用，避免限流（github PAT，read-only 即可）
GITHUB_TOKEN=<GITHUB_PAT>
